{
  "name": "absence-rh-system",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "framer-motion": "^12.40.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "next": "^14.2.35",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "react": "^18",
    "react-datepicker": "^4.25.0",
    "react-dom": "^18",
    "react-select": "^5.8.0",
    "recharts": "^3.10.1",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "autoprefixer": "^10.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6"
  },
  "build": {
    "appId": "com.doualair.absences",
    "productName": "Doualair Absences",
    "directories": {
      "app": "desktop",
      "output": "release"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Doualair-Absences-${version}-win-${arch}.${ext}"
    }
  }
}
